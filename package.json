{
  "name": "sanveda",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix website",
    "dev:website": "npm run dev --prefix website",
    "dev:admin": "npm run dev --prefix admin",
    "dev:all": "npx concurrently -k -n website,admin -c blue,magenta \"npm run dev:website\" \"npm run dev:admin\"",
    "build:website": "npm run build --prefix website",
    "build:admin": "npm run build --prefix admin",
    "build": "npm run build:website && npm run build:admin && node scripts/assemble-dist.mjs && npm run size:check",
    "typecheck": "npm run typecheck --prefix website && npm run typecheck --prefix admin && tsc -p tsconfig.api.json",
    "lint": "oxlint --deny-warnings website/src admin/src backend/api vite.config.ts vitest.config.ts playwright.config.ts",
    "format": "oxfmt --write .github backend/api .oxfmtrc.json .oxlintrc.json README.md docs package.json playwright.config.ts scripts website admin tsconfig.json tsconfig.api.json",
    "format:check": "oxfmt --check .github backend/api .oxfmtrc.json .oxlintrc.json README.md docs package.json playwright.config.ts scripts website admin tsconfig.json tsconfig.api.json",
    "preview": "npm run preview --prefix website",
    "test": "npm run test --prefix website --if-present",
    "test:watch": "npm run test --prefix website -- --watch",
    "test:browser": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "size:check": "node scripts/check-bundle.mjs",
    "test:data-import": "node --test backend/scripts/data-import-helpers.test.mjs",
    "verify:migrations": "bash backend/scripts/verify-migrations.sh",
    "check:runtime": "node scripts/check-runtime-sources.mjs",
    "data:import": "node --env-file-if-exists=.env backend/scripts/import-supabase-data.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:data-import && npm run verify:migrations && npm run check:runtime && npm run build",
    "db:migrate": "bash backend/scripts/apply-migrations.sh",
    "db:purge-demo": "bash backend/scripts/purge-demo-seed.sh",
    "db:seed-demo": "bash backend/scripts/seed-demo.sh",
    "setup:prod": "bash backend/scripts/setup-production.sh",
    "deploy:prod": "vercel --prod --yes"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "axios": "^1.18.1",
    "better-auth": "^1.6.23",
    "dompurify": "^3.4.11",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.9.1",
    "swiper": "^12.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.4",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
