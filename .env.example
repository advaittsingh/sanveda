# Supabase — https://supabase.com/dashboard/project/xkimzgtmrsrevpnawmmo/settings/api
VITE_SUPABASE_URL=https://xkimzgtmrsrevpnawmmo.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Database migrations (npm run db:migrate) — one of:
SUPABASE_DB_PASSWORD=your-db-password
# SUPABASE_ACCESS_TOKEN=sbp_...  # Dashboard → Account → Access Tokens

# Admin fallback password (used when Supabase admin auth is not set up)
VITE_ADMIN_PASSWORD=change-me-in-production

# ─── Razorpay Standard Checkout ─────────────────────────────────────────────
# Frontend (Vite): KEY_ID only — never put KEY_SECRET in VITE_* vars
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Server secrets for local reference / scripts (used by Supabase Edge Functions,
# not bundled into the Vite client because they lack the VITE_ prefix)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key

# ─── Supabase Edge Function secrets (set via CLI / Dashboard) ───────────────
# supabase secrets set RAZORPAY_KEY_ID=rzp_test_... RAZORPAY_KEY_SECRET=...
# RESEND_API_KEY=re_xxxxxxxx
# FROM_EMAIL=Sanveda <noreply@yourdomain.com>
#
# Deploy functions (after `supabase login` + `supabase link --project-ref xkimzgtmrsrevpnawmmo`):
#   supabase functions deploy create-razorpay-order
#   supabase functions deploy verify-razorpay-payment
#   supabase functions deploy send-email
#   supabase functions deploy razorpay-webhook
