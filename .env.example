# Neon / Vercel Postgres — server-only; never prefix database credentials with VITE_
# Prefer the pooled URL for the API. Either DATABASE_URL or POSTGRES_URL works.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require
# POSTGRES_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require
# POSTGRES_URL_NON_POOLING=postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Fallback / canonical site origin. Production also trusts custom domains in code.
BETTER_AUTH_URL=http://localhost:5173
# Optional comma-separated extra origins/hosts (e.g. preview URLs)
# BETTER_AUTH_TRUSTED_ORIGINS=https://sanveda-git-feature-curvvtech.vercel.app

# Vercel Blob private store. Vercel deployments should prefer project OIDC.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ─── Razorpay Standard Checkout ─────────────────────────────────────────────
# Frontend (Vite): KEY_ID only — never put KEY_SECRET in VITE_* vars
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Server-side Razorpay credentials; never expose these with a VITE_ prefix.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Server-side email (Resend) — required for contact confirmations & org alerts
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=Sanveda <noreply@yourdomain.com>
# Where new /contact enquiries are delivered (defaults to Sanvedacharityfoundation@gmail.com)
CONTACT_NOTIFY_EMAIL=Sanvedacharityfoundation@gmail.com
ADMIN_INVITE_REDIRECT_URL=https://yourdomain.com/reset-password
